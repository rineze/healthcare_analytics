# Python
__pycache__/
*.pyc
*.pyo

# Environment
.env

# Streamlit secrets (all subdirectories)
**/.streamlit/secrets.toml

# Large data dirs (regenerated by loaders — never commit)
pfs_data/
rvu25a/
locality_data/
data/

# Large files
*.zip
*.csv
*.xlsx

# IDE
.vscode/
.idea/

# Portfolio (personal financial data — never commit)
# Raw broker exports and generated reports. config.yaml carries account masks
# and target allocation; config.example.yaml is the committed template.
portfolio/inbox/*
!portfolio/inbox/.gitkeep
portfolio/reports/*
!portfolio/reports/.gitkeep
portfolio/config.yaml

# Misc
tmpclaude-*
*.tmp
_ul
